@rendermode InteractiveServer

@page "/"
@using Developers.Stream.Components.Layout
@using System.Diagnostics.CodeAnalysis

<PageTitle>Home</PageTitle>

<InputText @bind-Value="_searchInput" class="form-control mb-3" placeholder="Search streamers..."
           @oninput="HandleSearchInputChange"
           @bind-Value:after="OnInputChanged" />

<StreamerCards @ref="_streamerCards" />

@code
{
    [AllowNull]
    private StreamerCards _streamerCards;
    private string? _searchInput;

    private CancellationTokenSource _cts = new CancellationTokenSource();

    private Task HandleSearchInputChange(ChangeEventArgs e)
    {
        _searchInput = e.Value?.ToString();
        return OnInputChanged();
    }

    private async Task OnInputChanged()
    {
        await _cts.CancelAsync();
        _cts = new CancellationTokenSource();
        var cancellationToken = _cts.Token;

        try
        {
            await Task.Delay(500, cancellationToken);

            if (!cancellationToken.IsCancellationRequested)
            {
                await _streamerCards.OnFilterChanged(_searchInput ?? string.Empty, cancellationToken);
            }
        }
        catch (TaskCanceledException)
        { }
    }

}

